# All real providers remain disabled. Never commit an actual .env.
NR_MODE=synthetic
NR_RADAR_PAUSED=true
NR_TIMEZONE=America/Lima
# Set a random value of at least 32 characters to enable private API access.
# NR_SERVICE_TOKEN=
# NR_DASHBOARD_PASSWORD=
# NR_DATABASE_URL=postgresql+psycopg://nicheradar:password@127.0.0.1:5432/nicheradar
NR_API_URL=http://127.0.0.1:8000
NR_API_HOST=127.0.0.1
NR_API_PORT=8000
NR_DASHBOARD_HOST=127.0.0.1
NR_DASHBOARD_PORT=8501
NR_WORKER_POLL_SECONDS=30
NR_WORKER_MAXIMUM_ATTEMPTS=3
NR_EXTERNAL_CONCURRENCY=1
NR_BATCH_SIZE=20
# Versioned observed-trend controls; tolerance allows collection-time jitter.
NR_TREND_INTERVAL_TOLERANCE=0.1
NR_TREND_LOOKBACK_DAYS=90
# Optional CPU embeddings: use an existing, vetted local model with an immutable version.
# No model is downloaded at runtime. The default is an explicit provider-category fallback.
# NR_EMBEDDING_MODEL_DIRECTORY=/models/local-model
# NR_EMBEDDING_MODEL_VERSION=
NR_EMBEDDING_BATCH_SIZE=16
NR_TOPIC_RELEVANCE_THRESHOLD=0.35
NR_TOPIC_MINIMUM_SIZE=3
NR_TOPIC_SIMILARITY_THRESHOLD=0.8
NR_TOPIC_MAXIMUM_VIDEOS=200
NR_TOPIC_MAXIMUM_TEXT_CHARS=2000
# Existing chat subscriptions are not API credentials.
# Own API key from https://app.vidiq.com/account/settings/mcp (Bearer authentication).
# Never copy a conversation connector's credentials or put the key in shell arguments.
# Keep it in the private .env (0600) or the worker's secret environment in Easypanel.
# Configuring this does not enable live jobs. See docs/vidiq-connection.md.
# NR_VIDIQ_TOKEN=
# Stable non-secret label; changing accounts requires a different value.
# NR_VIDIQ_AUTH_SCOPE=personal-primary
# Timestamp of a successful `nicheradar-vidiq --check-connection` for this credential.
# NR_VIDIQ_CONNECTION_VALIDATED_AT=2026-09-21T00:00:00Z
# Confirm from the account; the MCP balance response supplies only the renewal end.
# NR_VIDIQ_CREDIT_CYCLE_STARTED_AT=
# Separate technical and user-authorization gates. Keep both false during preparation.
NR_VIDIQ_LIVE_ENABLED=false
NR_VIDIQ_PILOT_AUTHORIZED=false
# Optional direct enrichment of vidIQ candidates with YouTube videos.list.
# The key belongs to a Google Cloud project with YouTube Data API v3 enabled.
# Configuration alone does not activate calls; keep the radar paused during validation.
# NR_YOUTUBE_API_KEY=
# NR_YOUTUBE_AUTH_SCOPE=personal-youtube-project
# NR_YOUTUBE_CONNECTION_VALIDATED_AT=2026-09-23T00:00:00Z
NR_YOUTUBE_LIVE_ENABLED=false
NR_YOUTUBE_QUOTA_PER_RUN=0
NR_YOUTUBE_QUOTA_PER_WEEK=0
NR_YOUTUBE_QUOTA_PER_MONTH=0
NR_YOUTUBE_MAXIMUM_VIDEOS=100
# Optional explanation emphasis; never enabled by existing chat subscriptions.
NR_LLM_ENABLED=false
# NR_LLM_API_KEY=
# NR_LLM_CONFIGURATION=<documented JSON tariff, account scope and USD limits>
# See docs/explanations.md. No model, pricing or usage policy is preselected.

# Market intelligence (marketplace listings). The scraper has its own pause switch in the
# dashboard; in live mode it stays off until the Terms of Service of the source are reviewed.
NR_MARKET_INTEL_LIVE_ENABLED=false
NR_MARKET_INTEL_BASE_URL=https://dealbaron.com
NR_MARKET_INTEL_MAX_PAGES=200
NR_MARKET_INTEL_REQUEST_DELAY_SECONDS=1.0
NR_MARKET_INTEL_DETAIL_CAP_PER_RUN=300
NR_MARKET_INTEL_CLASSIFY_CAP_PER_RUN=100
NR_MARKET_INTEL_VERIFY_CAP_PER_RUN=20
